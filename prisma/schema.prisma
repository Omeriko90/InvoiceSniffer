generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum PlanTier {
  FREE
  PRO
  BUSINESS
}

enum ExtractionMethod {
  HEURISTIC
  AI
  MANUAL
  // Structured data pulled directly from an accounting-platform API
  // (src/lib/integrations) — no heuristic/vision extraction was needed.
  API
}

// Where an invoice originated. GMAIL is the legacy default (every pre-migration
// row); the rest are accounting-platform connectors (src/lib/integrations). Kept
// in lockstep with the InvoiceSource used on IntegrationCredential.provider.
enum InvoiceSource {
  GMAIL
  MORNING
  XERO
  ICOUNT
  QUICKBOOKS
  FRESHBOOKS
  SUMIT
  BIZIBOX
  TAKZIVIT
  PAPERLESS
}

enum DocumentType {
  TAX_INVOICE
  RECEIPT
  CREDIT_INVOICE
  UNKNOWN
}

enum InvoiceStatus {
  DETECTED
  REVIEWED
  MATCHED
  UNMATCHED
  IGNORED
}

enum AliasType {
  POSITIVE
  NEGATIVE
  IGNORE
}

// Business expense categories. Fixed set (not user-editable) kept in lockstep
// with src/lib/invoice-categories.ts, which is the source of truth for labels,
// colors and validation. UNCATEGORIZED is the default and the fail-open value
// when the LLM categorizer is disabled or unsure.
enum InvoiceCategory {
  MARKETING
  EQUIPMENT
  SOFTWARE
  TRAVEL
  OFFICE_SUPPLIES
  PROFESSIONAL_SERVICES
  UTILITIES
  OTHER
  UNCATEGORIZED
}

// Why an invoice was removed from the user's list (soft-delete). The invoice's
// own `status` is left untouched — a non-null `removedAt` is the removal signal.
// NOT_AN_INVOICE is a human-labeled false positive (feeds classifier learning);
// NOT_RELEVANT is a real invoice the user just doesn't want to see.
enum RemovalReason {
  NOT_RELEVANT
  NOT_AN_INVOICE
}

// How often a fixed expense is expected to bill. Drives the period windows the
// arrival status and the missing-invoice alert are computed over
// (src/lib/fixed-expenses.ts).
enum FixedExpenseFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

// PAUSED fixed expenses are skipped by both the ingest linker and the
// missing-invoice alert job; ACTIVE is the default.
enum FixedExpenseStatus {
  ACTIVE
  PAUSED
}

enum AliasSource {
  USER
  SYSTEM_LEARNED
}

enum AnomalyType {
  AMOUNT_HIGH
  AMOUNT_LOW
  SPEND_SPIKE
  MISSING_RECURRING
  NEW_VENDOR
}

enum AnomalySeverity {
  LOW
  MEDIUM
  HIGH
}

enum ExportStatus {
  QUEUED
  BUILDING
  READY
  EXPIRED
  FAILED
}

enum ExportFormat {
  CSV
  XLSX
  PDF
}

enum TransactionStatus {
  UNMATCHED
  POSSIBLE
  MATCHED
  NO_INVOICE
}

// ─── Models ───────────────────────────────────────────────

model Organization {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  planTier          PlanTier @default(FREE)
  // Max days a card charge may post AFTER its invoice (credit-card settlement
  // lag). Widens the reconcile match window on the "invoice precedes charge"
  // side and the invoice-candidate lookback. Configurable per org.
  settlementLagDays Int      @default(30)
  createdAt         DateTime @default(now())

  users                  User[]
  gmailCredentials       GmailCredential[]
  integrationCredentials IntegrationCredential[]
  invoices               Invoice[]
  vendorAliases          VendorAlias[]
  vendorStats            VendorStats[]
  anomalyLogs            AnomalyLog[]
  exportJobs             ExportJob[]
  transactions           Transaction[]
  csvMappings            CsvMapping[]
  classificationBatches  ClassificationBatch[]
  fixedExpenses          FixedExpense[]
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  emailVerified  DateTime?
  name           String?
  image          String?
  googleId       String?   @unique
  role           UserRole  @default(MEMBER)
  organizationId String
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accounts     Account[]
  sessions     Session[]
}

// ─── NextAuth tables ──────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Gmail ────────────────────────────────────────────────

model GmailCredential {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  label          String? // user-facing display name; falls back to email
  accessToken    String // AES-256-GCM encrypted
  refreshToken   String // AES-256-GCM encrypted
  expiresAt      DateTime
  scopes         String[]
  connected      Boolean   @default(true)
  syncToken      String? // Gmail historyId for incremental syncs
  lastSyncedAt   DateTime?
  watchExpiry    DateTime? // Pub/Sub watch expiry — renew every 6 days
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices     Invoice[]

  @@unique([organizationId, email])
}

// ─── Accounting-platform integrations ─────────────────────

// A connected accounting/invoicing platform account (Morning, Xero, iCount, …).
// The provider-agnostic analog of GmailCredential: one row per connected account,
// with all secrets in a single AES-256-GCM encrypted blob. See src/lib/integrations.
model IntegrationCredential {
  id                String        @id @default(cuid())
  organizationId    String
  provider          InvoiceSource // never GMAIL here — that lives on GmailCredential
  label             String? // user-facing display name; falls back to the provider name
  // Provider account identity: Xero tenantId, Morning business id, etc. Part of
  // the uniqueness key so the same org can connect two accounts of one provider.
  externalAccountId String?
  authKind          String // 'oauth2' | 'apiKey'
  // AES-256-GCM encrypted JSON (src/lib/encryption). Shape depends on authKind:
  //   oauth2 -> { accessToken, refreshToken, expiresAt }
  //   apiKey -> { id, secret, jwt?, jwtExpires? }
  secrets           String
  config            Json          @default("{}") // non-secret provider config
  connected         Boolean       @default(true) // false = soft-disconnected (history kept)
  // What the user wants this account to do, clamped to the connector's
  // capabilities: 'PULL' (import expenses), 'PUSH' (export bookkeeping), 'BOTH'.
  direction         String        @default("BOTH")
  pullCursor        String? // incremental sync cursor (provider-specific)
  lastPulledAt      DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices     Invoice[]
  syncs        InvoiceSync[]
  categoryMaps IntegrationCategoryMap[]

  @@unique([organizationId, provider, externalAccountId])
  @@index([organizationId])
}

// PUSH ledger: records which invoices were exported to which integration, so a
// re-push is a no-op (idempotency) and failures are surfaced. One row per
// (invoice, integration).
model InvoiceSync {
  id                      String    @id @default(cuid())
  invoiceId               String
  integrationCredentialId String
  externalId              String? // id the provider returned when it created the record
  status                  String    @default("PENDING") // PENDING | SYNCED | FAILED
  lastError               String?
  syncedAt                DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  invoice    Invoice               @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  credential IntegrationCredential @relation(fields: [integrationCredentialId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, integrationCredentialId])
  @@index([integrationCredentialId, status])
}

// Maps our fixed InvoiceCategory enum to a provider's own chart-of-accounts /
// expense-category id, per connected account. Unmapped categories fall back to
// the provider default on push (v1 — a mapping UI comes later).
model IntegrationCategoryMap {
  id                      String          @id @default(cuid())
  integrationCredentialId String
  invoiceCategory         InvoiceCategory
  externalCategoryId      String

  credential IntegrationCredential @relation(fields: [integrationCredentialId], references: [id], onDelete: Cascade)

  @@unique([integrationCredentialId, invoiceCategory])
}

// ─── Invoices ─────────────────────────────────────────────

model Invoice {
  id                      String           @id @default(cuid())
  organizationId          String
  // Where this invoice came from. Defaults to GMAIL so every pre-migration row
  // is correct without a data change; accounting-platform pulls set MORNING/XERO/…
  source                  InvoiceSource    @default(GMAIL)
  // Set when the invoice was pulled from an accounting platform; null for Gmail
  // and manual invoices. Cleared (SetNull) if the integration is deleted.
  integrationCredentialId String?
  // Provider's own document id + a deep link back to it. For GMAIL rows these are
  // backfilled from gmailMessageId / gmailLink so the cross-source dedup key below
  // is populated for every row.
  externalId              String?
  externalRef             String?
  gmailCredentialId       String? // source mailbox; nullable only for pre-migration orphans
  gmailMessageId          String? // Gmail-only; null for API/manual sources
  gmailThreadId           String? // Gmail-only; null for API/manual sources
  gmailLink               String? // Gmail-only; null for API/manual sources
  senderEmail             String
  senderName              String?
  subject                 String
  emailDate               DateTime
  vendorName              String?
  vendorNormalized        String?
  invoiceNumber           String?
  allocationNumber        String? // Israeli Tax Authority clearance id (מספר הקצאה); LLM-only
  vendorTaxId             String? // business id (ח.פ. / ע.מ. / VAT); LLM-only
  documentType            DocumentType     @default(UNKNOWN)
  invoiceDate             DateTime?
  dueDate                 DateTime?
  totalAmount             Decimal          @db.Decimal(12, 2)
  currency                String           @default("USD")
  taxAmount               Decimal?         @db.Decimal(12, 2)
  lineItems               Json             @default("[]")
  attachmentMeta          Json             @default("[]")
  receiptUrl              String?
  extractionMethod        ExtractionMethod @default(HEURISTIC)
  extractionConfidence    Float            @default(0)
  status                  InvoiceStatus    @default(DETECTED)
  // Business expense category. Auto-assigned at ingest by the LLM categorizer
  // (llm-categorizer.ts) and overridable by the user; UNCATEGORIZED until set.
  category                InvoiceCategory  @default(UNCATEGORIZED)
  anomalyFlag             Boolean          @default(false)
  // Soft-delete: hidden from every list when removedAt is set. status is never
  // changed on removal; removalReason records why (see RemovalReason). Cleared on undo.
  removedAt               DateTime?
  removalReason           RemovalReason?
  // Set when this invoice satisfies a fixed expense for its period — the single
  // source of truth for arrival tracking. Assigned inline by the ingest linker
  // (invoice-extract.ts) on vendor/sender match, or manually from the drawer.
  // Cleared automatically if the fixed expense is deleted (onDelete: SetNull).
  fixedExpenseId          String?
  // Provenance from the reconcile session that matched this invoice: which CSV
  // it was reconciled against and when. Nullable — set on confirm/link, cleared
  // on undo. Powers the "reconciled against <file>" breadcrumb and collision
  // warnings when a later session re-matches an already-reconciled invoice.
  reconciledSourceFile    String?
  reconciledAt            DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gmailCredential       GmailCredential?       @relation(fields: [gmailCredentialId], references: [id], onDelete: SetNull)
  integrationCredential IntegrationCredential? @relation(fields: [integrationCredentialId], references: [id], onDelete: SetNull)
  fixedExpense          FixedExpense?          @relation(fields: [fixedExpenseId], references: [id], onDelete: SetNull)
  anomalyLogs           AnomalyLog[]
  transactions          Transaction[]
  syncs                 InvoiceSync[]

  @@unique([organizationId, gmailMessageId])
  // Cross-source dedup: one invoice per (org, source, provider document id).
  // Populated for GMAIL rows via backfill (externalId = gmailMessageId).
  @@unique([organizationId, source, externalId])
  @@index([organizationId, emailDate])
  @@index([organizationId, vendorNormalized])
  @@index([organizationId, status])
  @@index([organizationId, removedAt])
  // Serves both the invoices-list category filter and the dashboard's
  // date-scoped spend-by-category group-by.
  @@index([organizationId, category, emailDate])
  // Powers the fixed-expense detail drawer's per-period invoice lookup.
  @@index([organizationId, fixedExpenseId])
  @@index([gmailCredentialId])
  @@index([integrationCredentialId])
}

// ─── Fixed expenses ───────────────────────────────────────

// A user-defined recurring bill the org expects to receive (rent, SaaS, etc.).
// Arrival is tracked by linking matching invoices (Invoice.fixedExpenseId); the
// per-period status is always COMPUTED from the linked invoices + the current
// window (src/lib/fixed-expenses.ts), never stored — so it resets to "pending"
// on its own each new period. See enums FixedExpenseFrequency / FixedExpenseStatus.
model FixedExpense {
  id                String                @id @default(cuid())
  organizationId    String
  name              String
  // Reuses the shared invoice category enum (src/lib/invoice-categories.ts).
  category          InvoiceCategory       @default(UNCATEGORIZED)
  // Match signals — "from where it should be coming". vendorNormalized is the
  // primary key (normalizeVendor(vendorName)); senderEmail is the secondary.
  vendorName        String?
  vendorNormalized  String?
  senderEmail       String?
  // Optional: pin matching to a single connected mailbox.
  gmailCredentialId String?
  // Expected amount is a soft signal only (shown, not enforced when matching).
  expectedAmount    Decimal?              @db.Decimal(12, 2)
  currency          String                @default("USD")
  frequency         FixedExpenseFrequency @default(MONTHLY)
  // Reference point the period windows roll forward from.
  anchorDate        DateTime
  // Days after a period ends before a missing invoice counts as overdue/alerts.
  gracePeriodDays   Int                   @default(5)
  status            FixedExpenseStatus    @default(ACTIVE)
  createdById       String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices     Invoice[]

  @@index([organizationId, status])
  @@index([organizationId, vendorNormalized])
}

// ─── Learning ─────────────────────────────────────────────

model VendorAlias {
  id              String      @id @default(cuid())
  organizationId  String
  merchantPattern String
  vendorName      String
  senderEmail     String?
  type            AliasType
  source          AliasSource @default(USER)
  useCount        Int         @default(0)
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, merchantPattern])
  @@index([organizationId, type, active])
}

// ─── Analytics ────────────────────────────────────────────

model VendorStats {
  id                String   @id @default(cuid())
  organizationId    String
  vendorName        String
  invoiceCount      Int      @default(0)
  avgAmount         Decimal  @db.Decimal(12, 2)
  medianAmount      Decimal  @db.Decimal(12, 2)
  stdDevAmount      Decimal  @default(0) @db.Decimal(12, 2)
  minAmount         Decimal  @db.Decimal(12, 2)
  maxAmount         Decimal  @db.Decimal(12, 2)
  typicalDayOfMonth Int?
  isRecurring       Boolean  @default(false)
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, vendorName])
}

model AnomalyLog {
  id             String          @id @default(cuid())
  organizationId String
  invoiceId      String?
  vendorName     String
  type           AnomalyType
  severity       AnomalySeverity
  details        Json
  acknowledged   Boolean         @default(false)
  createdAt      DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([organizationId, acknowledged])
}

// ─── Exports ──────────────────────────────────────────────

model ExportJob {
  id             String       @id @default(cuid())
  organizationId String
  format         ExportFormat @default(PDF)
  dateRangeStart DateTime
  dateRangeEnd   DateTime
  invoiceIds     String[]
  // Chosen spreadsheet columns (CSV/XLSX); empty for PDF.
  fields         String[]
  status         ExportStatus @default(QUEUED)
  r2Key          String?
  downloadUrl    String?
  fileName       String?
  mimeType       String?
  // Invoices with no PDF / a fetch failure — [{ invoiceId, vendorName, reason }].
  skippedCount   Int          @default(0)
  skipped        Json         @default("[]")
  startedAt      DateTime?
  finishedAt     DateTime?
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([status])
}

// ─── Transactions (CSV imports) ───────────────────────────

model Transaction {
  id               String            @id @default(cuid())
  organizationId   String
  date             DateTime
  merchant         String
  amount           Decimal           @db.Decimal(12, 2)
  currency         String            @default("USD")
  status           TransactionStatus @default(UNMATCHED)
  matchedInvoiceId String?
  matchConfidence  Float?
  matchReason      String?
  matchConfirmed   Boolean           @default(false)
  sourceFile       String?
  // Natural-key hash (date|merchant|amount|currency) set at import time so a
  // re-uploaded statement dedupes instead of doubling transactions. Nullable:
  // rows imported before this column stay null (Postgres allows many nulls in a
  // unique index), so no backfill is needed and only new imports are deduped.
  dedupeKey        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  matchedInvoice Invoice?     @relation(fields: [matchedInvoiceId], references: [id], onDelete: SetNull)

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, date])
  @@index([organizationId, status])
}

model CsvMapping {
  id             String   @id @default(cuid())
  organizationId String
  label          String // e.g. "Amex" — shown as "Saved mapping for Amex"
  headersKey     String // normalized CSV header signature used for auto-apply
  mapping        Json // { date, merchant, amount, currency? } → CSV column names
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, headersKey])
}

// ─── LLM batch classification (ephemeral waiting-list) ────
//
// The Gemini Batch API is asynchronous: a Gmail sync submits borderline
// messages as one batch and returns; a later scheduled `classify-consume` run
// polls the batch, applies verdicts, and DELETES these rows. So both tables are
// short-lived operational bookkeeping, not durable app state — a batch row and
// its items exist only between submit and consume (see src/workers/run-batch.ts).

model ClassificationBatch {
  id             String    @id @default(cuid())
  organizationId String
  credentialId   String // the GmailCredential this batch's messages came from
  provider       String    @default("gemini-batch")
  resourceName   String? // Vertex BatchJob.name; null only if create() failed
  model          String // CLASSIFIER_MODEL used to build the batch
  state          String    @default("QUEUED") // QUEUED|RUNNING — row is DELETED once consumed
  itemCount      Int
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  finishedAt     DateTime?

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        PendingClassification[]

  @@index([state])
  @@index([organizationId, createdAt])
}

model PendingClassification {
  id                   String  @id @default(cuid())
  batchId              String
  organizationId       String
  credentialId         String
  gmailMessageId       String
  requestIndex         Int // position in the batch's inlinedRequests[] (maps back the verdict)
  // Fail-open fallback: post-penalty candidacy (score >= threshold). Used as the
  // final verdict if the batch errors/expires or an item's response is missing.
  heuristicIsCandidate Boolean
  // Pre-penalty candidacy (detection.isCandidate). Only used to reproduce the
  // deferred vendorAlias.useCount "learned rule worked" increment on consume.
  rawIsCandidate       Boolean
  senderEmail          String // sender for the deferred vendorAlias.useCount increment
  hadPenalty           Boolean

  batch ClassificationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([credentialId, gmailMessageId]) // dedup across re-syncs
  @@index([batchId])
}
